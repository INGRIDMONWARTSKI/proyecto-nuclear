PORT=3000
JWT_SECRET=super-secreto
JWT_EXPIRES_IN=1d
POSTGREST_URL=http://localhost:3001
POSTGREST_SCHEMA=public
POSTGREST_API_KEY=
FRONTEND_URL=http://localhost:4200
# En Railway, configura POSTGREST_URL y FRONTEND_URL en el panel de variables
# (no dupliques claves en .env local: la última gana y rompe el desarrollo).
# Correo (obligatorio para envío real). Copia este archivo a .env y reemplaza los placeholders.
# Gmail: activa 2FA y genera una "Contraseña de aplicación" (16 caracteres, sin espacios en SMTP_PASS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-app-password-sin-espacios
SMTP_FROM=MENTORA <tu-cuenta@gmail.com>
ADMIN_EMAIL=admin@nuclear.local
ADMIN_PASSWORD=Admin123*
ADMIN_FULL_NAME=Administrador General
# Google Gemini (requerido para generar casos con IA)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# Ollama (fallback local opcional para generar casos con IA)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# OLLAMA_TIMEOUT_MS=300000
